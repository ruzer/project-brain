{
  "name": "@ruzer/project-brain",
  "version": "0.3.0",
  "description": "Contexto verificable y ligero para repositorios de software.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./schema/context-contract.schema.json"
  },
  "bin": {
    "brain": "./bin/brain.mjs"
  },
  "files": [
    "bin",
    "schema",
    "src",
    "templates",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm test && node bin/brain.mjs doctor .",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruzer/project-brain.git"
  },
  "keywords": [
    "ai-context",
    "agents",
    "obsidian",
    "repository"
  ],
  "license": "MIT"
}
